# --- LLM ---
# LLM_MODE=stub runs fully offline with deterministic rule-based output (used
# by tests / CI, and the default here since it's instant). LLM_MODE=live uses
# the OpenAI-compatible endpoint below - verified working end to end, but a
# free-tier model can take 3-4 minutes for a full investigation (~6-7 calls).
LLM_MODE=stub
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-oss-20b:free
LLM_MAX_CALLS_PER_INVESTIGATION=8
LLM_TIMEOUT_SECONDS=45

# --- Qdrant ---
# Leave QDRANT_URL empty to use embedded (on-disk) Qdrant, at an absolute
# path under backend/data_out computed automatically (works regardless of
# the process's working directory - do not set QDRANT_PATH to a relative
# path, it will resolve differently depending on where you launch from).
# Set QDRANT_URL=http://localhost:6333 to use the docker-compose service instead.
QDRANT_URL=
QDRANT_COLLECTION=network_knowledge

# --- Embeddings ---
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- MLflow ---
# Leave MLFLOW_TRACKING_URI unset for the same reason as QDRANT_PATH above.
MLFLOW_EXPERIMENT=network-intelligence-copilot

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DATA_SEED=42
